# spectrometerv2 configuration
#
# Generated from the configuration schema: every key below is listed with
# its purpose, type, default, and allowed values. Edit values as needed —
# invalid or out-of-range values are rejected at startup with a clear message.
# Any value can also be overridden per-run with: --set section.key=value
#
# Alternate setups: keep additional complete config files in this folder
# (e.g. config/lab.ini) and select one with: --config config/lab.ini

[general]
# Target platform hint. 'auto' detects at runtime.
#   (type=str; default=auto; choices=auto, linux, windows, raspberrypi)
platform = auto


[logging]
# Minimum log level.
#   (type=str; default=INFO; choices=DEBUG, INFO, WARNING, ERROR, CRITICAL)
level = INFO

# Directory for rotating log files (LOG-002).
#   (type=path; default=logs)
directory = logs

# Max bytes per log file before rotation.
#   (type=int; default=1048576; min=1024)
max_bytes = 1048576

# Number of rotated log files to retain.
#   (type=int; default=5; min=0)
backup_count = 5

# Also emit logs to stderr.
#   (type=bool; default=true)
console = true


[camera]
# Camera source. 'auto' picks the CSI (Pi ribbon) camera on a Raspberry Pi, otherwise a USB camera; 'csi' = Pi ribbon camera; 'usb' = USB/webcam; 'synthetic' = simulated data (clearly labelled). ('picamera2' is accepted as an alias for 'csi'.)
#   (type=str; default=auto; choices=auto, usb, csi, picamera2, synthetic)
backend = auto

# When 'auto' finds no camera: 'prompt' asks (only in an interactive terminal; otherwise behaves like 'error'), 'error' exits with guidance, 'synthetic' falls back to simulated data with a warning.
#   (type=str; default=prompt; choices=prompt, error, synthetic)
on_missing = prompt

# Index of the camera device.
#   (type=int; default=0; min=0)
device_index = 0

# Requested frame width in pixels.
#   (type=int; default=1920; min=1)
width = 1920

# Requested frame height in pixels.
#   (type=int; default=1080; min=1)
height = 1080


[gui]
# Target refresh rate for the live GUI view, frames per second.
#   (type=float; default=15.0; min=0.1; max=120.0)
fps = 15.0

# Number of recent frames (time rows) kept in the live waterfall.
#   (type=int; default=256; min=10; max=4000)
waterfall_frames = 256

# Directory where the GUI snapshot key (s) writes CSV + metadata.
#   (type=path; default=snapshots)
snapshot_dir = snapshots


[wavelet]
# PyWavelets wavelet family for the decomposition view.
#   (type=str; default=db4; choices=db4, db6, sym5, coif3)
wavelet = db4

# Decomposition depth. Clamped at compute time to the maximum the sample count allows (see the effective-level readout).
#   (type=int; default=4; min=1; max=12)
level = 4


[annealing]
# Cooling schedule: 'fast' (log), 'medium' (geometric), 'slow' (linear).
#   (type=str; default=medium; choices=fast, medium, slow)
schedule = medium

# Maximum temperature cycles (compute budget).
#   (type=int; default=200; min=1; max=5000)
max_cycles = 200

# Normalized-error tolerance for early termination.
#   (type=float; default=1e-05; min=0.0; max=1.0)
tol = 1e-05

# Number of Gaussian components to fit; 0 = auto (derive from the detected peaks). Sets the Markov-chain length.
#   (type=int; default=0; min=0; max=64)
n_components = 0

# How tightly per-parameter bounds hug the seed values (0 = loose, 1 = pinned). Used when bounds are derived from detected peaks.
#   (type=float; default=0.5; min=0.0; max=1.0)
bound_tightness = 0.5

# Random seed; recorded with each fit for reproducibility.
#   (type=int; default=0; min=0)
seed = 0

# Reuse the fixed seed every run (reproducible). If false, each fit draws a fresh seed.
#   (type=bool; default=true)
lock_seed = true


[influx]
# Also write each spectrum's scalar features to InfluxDB.
#   (type=bool; default=false)
enabled = false

# InfluxDB major version of the target server (v3 uses the v2 write API).
#   (type=int; default=2; choices=1, 2, 3)
version = 2

# Base URL of the InfluxDB server (local or remote).
#   (type=str; default=http://localhost:8086)
url = http://localhost:8086

# Organization (v2/v3).
#   (type=str; default=)
org = 

# Bucket to write to (v2/v3; on v3 this is the database name).
#   (type=str; default=spectrometer)
bucket = spectrometer

# API token, sent as an Authorization header (v2/v3).
#   (type=str; default=)
token = 

# Database name (v1).
#   (type=str; default=spectrometer)
database = spectrometer

# Username (v1, optional).
#   (type=str; default=)
username = 

# Password (v1, optional).
#   (type=str; default=)
password = 

# InfluxDB measurement name for the written points.
#   (type=str; default=spectrum)
measurement = spectrum

# Timestamp precision.
#   (type=str; default=ns; choices=ns, us, ms, s)
precision = ns

# HTTP write timeout, seconds.
#   (type=float; default=5.0; min=0.1; max=120.0)
timeout = 5.0

# Build and log the line protocol but do not POST it — for testing without a live server.
#   (type=bool; default=false)
dry_run = false


[sqlite]
# Also persist each spectrum to a SQLite database.
#   (type=bool; default=false)
enabled = false

# SQLite database file. Created (with its parent directory) on first use.
#   (type=path; default=data/spectrometer.db)
path = data/spectrometer.db

# Archive the full metadata dict as JSON on each capture row. Costs space; keeps provenance that the typed columns do not cover.
#   (type=bool; default=true)
store_metadata_json = true

# Lock-wait timeout, seconds.
#   (type=float; default=5.0; min=0.1; max=120.0)
timeout = 5.0

# SQLite journal mode. 'wal' lets a dashboard or notebook read while acquisition writes.
#   (type=str; default=wal; choices=wal, delete, truncate, persist, memory, off)
journal_mode = wal


[user_schema]
# Path to the user field manifest (INI). Blank = core schema only. Declared fields become typed SQLite columns and InfluxDB fields/tags. Kept out of this file because the config loader is closed-world, which is what keeps the core schema locked.
#   (type=str; default=)
manifest = 

# Optional 'module:function' called per capture, returning a dict of user field values. Only needed for quantities the pipeline does not already produce; fields with a 'from' path need no code.
#   (type=str; default=)
hook = 

# What to do when a user value fails validation (wrong type, outside 'allowed', or undeclared): 'error' aborts the write, 'warn' logs and drops the value, 'drop' discards it silently.
#   (type=str; default=error; choices=error, warn, drop)
on_violation = error


[processing]
# Sensor row used for the 1-D spectral slice; -1 = auto/center.
#   (type=int; default=-1; min=-1)
slice_row = -1


[calibration]
# Path to the saved wavelength calibration.
#   (type=path; default=config/calibration.json)
file = config/calibration.json


[synthetic]
# Lower wavelength bound, nm (SYN-006).
#   (type=float; default=380.0; min=0.0)
wavelength_min = 380.0

# Upper wavelength bound, nm (SYN-006).
#   (type=float; default=750.0; min=0.0)
wavelength_max = 750.0

# Wavelength sampling interval, nm (SYN-006).
#   (type=float; default=0.5; min=1e-06)
sample_interval = 0.5

# Default line FWHM, nm (SYN-004).
#   (type=float; default=2.0; min=1e-06)
fwhm = 2.0

# Signal-to-noise ratio (SYN-005).
#   (type=float; default=100.0; min=0.0)
snr = 100.0

# Baseline level (SYN-006).
#   (type=float; default=0.0)
baseline = 0.0

# Baseline slope per nm (SYN-006).
#   (type=float; default=0.0)
baseline_slope = 0.0

# Line profile (SYN-007). Only 'gaussian' is implemented initially.
#   (type=str; default=gaussian; choices=gaussian, lorentzian, voigt)
profile_type = gaussian

# Deterministic RNG seed for reproducibility (SYN-006, SYN-009).
#   (type=int; default=0; min=0)
seed = 0
