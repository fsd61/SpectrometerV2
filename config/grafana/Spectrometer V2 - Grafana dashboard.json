{
  "title": "Spectrometer V2 · The Doublet Hunter",
  "uid": "spectrometer-v2",
  "tags": [
    "spectrometer",
    "PBM",
    "influxdb"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "description": "Scalar telemetry from SpectrometerV2's InfluxDB sink (Flux). Full spectra and the doublet fit live in the app/SQLite, not InfluxDB.",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "InfluxDB",
        "type": "datasource",
        "query": "influxdb",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "bucket",
        "label": "Bucket",
        "type": "textbox",
        "query": "spectrometer",
        "current": {
          "text": "spectrometer",
          "value": "spectrometer"
        },
        "hide": 0
      },
      {
        "name": "measurement",
        "label": "Measurement",
        "type": "textbox",
        "query": "spectrum",
        "current": {
          "text": "spectrum",
          "value": "spectrum"
        },
        "hide": 0
      },
      {
        "name": "source",
        "label": "Source",
        "type": "custom",
        "query": "usb,picamera2,synthetic",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": true
          },
          {
            "text": "usb",
            "value": "usb",
            "selected": false
          },
          {
            "text": "picamera2",
            "value": "picamera2",
            "selected": false
          },
          {
            "text": "synthetic",
            "value": "synthetic",
            "selected": false
          }
        ],
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Status · is this data trustworthy?",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Data",
      "description": "Core field 'simulated'. Simulated points can never be mistaken for real ones.",
      "datasource": {
        "type": "influxdb",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "refId": "A",
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"${measurement}\" and r._field == \"simulated\")\n  |> filter(fn: (r) => r.source =~ /^${source:regex}$/)\n  |> last()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "true": {
                  "text": "SIMULATED",
                  "color": "orange",
                  "index": 0
                },
                "false": {
                  "text": "REAL",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Calibration",
      "description": "Core field 'calibrated'. The software refuses to serve wavelengths when the calibration does not match the backend.",
