# Byte-compiled / cache
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Runtime logs (LOG-002 writes here; never commit logs)
logs/

# SQLite store + its WAL sidecars (measurement data; never commit).
# Leading slash anchors this to the project root — an unanchored 'data/' would
# also match src/data/ and silently untrack the persistence package.
/data/
*.db
*.db-wal
*.db-shm

# The user's own field manifest is local setup; the .example is tracked
config/user_fields.ini

# Local config created by 'spectrometerv2 init-config'; only the .example and
# the config/profiles/*.ini alternates are tracked.
/config/config.ini

# Generated run output (CLI --output default and the GUI snapshot dir)
/out/
/snapshots/

# Test / tooling caches
.pytest_cache/
.coverage
htmlcov/

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/

# Leftover empty wrapper dir (mount blocks deletion; safe to remove from Windows)
.pyspectrometer2_emptied/

# Root-level run output from ad-hoc CLI invocations (the /out/ and /snapshots/
# rules above only cover the default output dirs).
/acquisition.csv
/acquisition.meta.json
/acquisition.png
/waterfall.png
/synthetic.csv
/synthetic.meta.json
/synthetic.png
# Personal scratch scripts kept out of the repository.
/git-push-db

# Profiling / import-timing artifacts
/importtime.log
/startup.prof

# Mount write-permission probe
/.git-write-test
